	measure 'Letalidade violenta (mes anterior)' =
			CALCULATE (
				[Letalidade violenta],
				PREVIOUSMONTH ( seg_periodo[PERI_DT_REFERENCIA] )
			)
		formatString: #,0
		displayFolder: 20 Tempo
		lineageTag: 1e894028-9e2f-4cc1-9f49-bf801fa36654

	measure 'Letalidade violenta (variacao %)' =
			VAR Atual = [Letalidade violenta]
			VAR Anterior = [Letalidade violenta (mes anterior)]
			RETURN
				DIVIDE ( Atual - Anterior, Anterior )
		formatString: 0.0%
		displayFolder: 20 Tempo
		lineageTag: 89cc304f-8e9c-4e1a-b91f-fcc51e1a3f00

	measure 'Mortes por intervencao do Estado (mes anterior)' =
