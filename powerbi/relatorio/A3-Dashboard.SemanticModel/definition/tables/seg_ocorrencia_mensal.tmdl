				seg_cisp_municipio[CIMU_FL_SEDE] = "S"
			)
		formatString: #,0
		displayFolder: 30 Territorio
		lineageTag: 63496780-0535-422f-af9f-3ee1fcad46c6

	measure 'Letalidade violenta (por sede)' =
