	partition seg_ocorrencia_mensal = m
		mode: import
		source =
				let
				    Fonte = MySQL.Database("localhost:3306", "seg_dashboard", [ReturnSingleDatabase=true]),
				    seg_dashboard_seg_ocorrencia_mensal = Fonte{[Schema="seg_dashboard",Item="seg_ocorrencia_mensal"]}[Data]
				in
				    seg_dashboard_seg_ocorrencia_mensal

	annotation PBI_ResultType = Table

