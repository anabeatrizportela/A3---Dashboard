table seg_ocorrencia_mensal
	lineageTag: d2466657-2538-4471-b39e-0fbf9d80b583

	measure '_Ocorrencias brutas' = SUM ( seg_ocorrencia_mensal[OCME_QT_OCORRENCIA] )
		formatString: #,0
		isHidden
		displayFolder: 00 Base
		lineageTag: 4934470b-8584-40b3-ba32-cfef0ca6dff3

	measure Ocorrencias =
			CALCULATE (
				[_Ocorrencias brutas],
				KEEPFILTERS ( seg_tipo_ocorrencia[TIOC_FL_AGREGADO] = "N" ),
				KEEPFILTERS ( seg_categoria_ocorrencia[CAOC_NM_CATEGORIA] <> "Atividade policial" )
			)
		formatString: #,0
		displayFolder: 00 Base
		lineageTag: e339ec27-e0ee-491d-95cc-de2f3f7b8e1f

	measure 'Atividade policial' =
			CALCULATE (
				[_Ocorrencias brutas],
				REMOVEFILTERS ( seg_tipo_ocorrencia ),
				REMOVEFILTERS ( seg_categoria_ocorrencia ),
				seg_categoria_ocorrencia[CAOC_NM_CATEGORIA] = "Atividade policial",
				seg_tipo_ocorrencia[TIOC_FL_AGREGADO] = "N"
			)
		formatString: #,0
		displayFolder: 00 Base
		lineageTag: 47709ad5-d17d-4fca-a98e-99667b921f50

	measure 'Total de BOs' = SUM ( seg_registro_mensal[REME_QT_REGISTRO_OCORRENCIAS] )
		formatString: #,0
		displayFolder: 00 Base
		lineageTag: 21515435-e236-4234-8d52-ed2d085edd22

	measure 'Qtd delegacias' = DISTINCTCOUNT ( seg_registro_mensal[CISP_ID_CISP] )
		formatString: #,0
		displayFolder: 00 Base
		lineageTag: 1f100014-25cf-49ef-9692-02c6dd3fb688

	measure 'Qtd municipios' =
			CALCULATE (
				DISTINCTCOUNT ( seg_cisp_municipio[MUNI_ID_MUNICIPIO] ),
				seg_cisp_municipio[CIMU_FL_SEDE] = "S"
			)
		formatString: #,0
		displayFolder: 00 Base
		lineageTag: 8c8d39ec-dd3c-4afd-9f1d-984bceb033b6

	measure 'Letalidade violenta' =
			CALCULATE (
				[_Ocorrencias brutas],
				REMOVEFILTERS ( seg_tipo_ocorrencia ),
				REMOVEFILTERS ( seg_categoria_ocorrencia ),
				seg_tipo_ocorrencia[TIOC_CD_TIPO_OCORRENCIA] = "letalidade_violenta"
			)
		formatString: #,0
		displayFolder: 10 KPIs
		lineageTag: 56f6b11f-2929-464b-a299-b77bd9394b55

	measure 'Mortes por intervencao do Estado' =
