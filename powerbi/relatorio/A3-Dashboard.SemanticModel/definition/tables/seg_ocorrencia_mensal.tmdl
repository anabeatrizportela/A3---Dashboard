	measure 'Rotulo do pico de letalidade' =
			VAR MesesVisiveis = ALLSELECTED ( seg_periodo[PERI_DT_REFERENCIA] )
			VAR MaiorValor =
				MAXX ( MesesVisiveis, [Letalidade violenta] )
			RETURN
				IF ( [Letalidade violenta] = MaiorValor, [Letalidade violenta] )
		formatString: #,0
		displayFolder: 20 Tempo
		lineageTag: 2aa03c74-af19-4e7b-9aa2-602372b51f33

	measure 'Letalidade violenta (media mensal)' =
			AVERAGEX (
				VALUES ( seg_periodo[PERI_DT_REFERENCIA] ),
				[Letalidade violenta]
			)
		formatString: #,0.0
		displayFolder: 20 Tempo
		lineageTag: c25a9032-6f81-49b0-b935-85ca4003c812

	measure 'Ocorrencias (por sede)' =
			CALCULATE (
