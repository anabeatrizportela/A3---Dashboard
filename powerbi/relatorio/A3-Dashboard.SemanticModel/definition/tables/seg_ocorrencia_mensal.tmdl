		lineageTag: 12b820cc-1e31-4770-8d71-44641331beaf

	measure 'Letalidade violenta (duplicacao da ponte)' =
			VAR SemFiltro = [Letalidade violenta]
			VAR ComSede = [Letalidade violenta (por sede)]
			RETURN
				SemFiltro - ComSede
		formatString: #,0
		displayFolder: 30 Territorio
		lineageTag: 95a6607b-7c48-498e-998a-66e5a0c599d6

	measure 'Posicao da delegacia (letalidade)' =
			IF (
				NOT ISBLANK ( [Letalidade violenta] ),
				RANKX (
					ALLSELECTED ( seg_cisp[CISP_NM_CISP] ),
					[Letalidade violenta],
					,
					DESC,
					DENSE
				)
			)
		formatString: #,0
		displayFolder: 30 Territorio
		lineageTag: 5ad48623-9841-4bee-8119-baeae6fd339e

	measure 'Esta no top 10 (letalidade)' = IF ( [Posicao da delegacia (letalidade)] <= 10, 1, 0 )
		formatString: #,0
		displayFolder: 30 Territorio
		lineageTag: 8cd4713e-af55-49cf-bb6b-5050560f04e9

	measure '% Crime patrimonial' =
			VAR Patrimonial =
				CALCULATE (
					[Ocorrencias],
					KEEPFILTERS (
						seg_categoria_ocorrencia[CAOC_NM_CATEGORIA]
							IN { "Roubos", "Furtos", "Outros crimes patrimoniais" }
					)
				)
			VAR Tudo =
				CALCULATE ( [Ocorrencias], REMOVEFILTERS ( seg_categoria_ocorrencia ) )
			RETURN
				DIVIDE ( Patrimonial, Tudo )
		formatString: 0.0%
		displayFolder: 30 Territorio
		lineageTag: 6aca62aa-80e6-4781-8245-c86c668d7167

	measure Populacao = SUM ( seg_municipio[MUNI_QT_POPULACAO] )
		formatString: #,0
		displayFolder: 40 Taxas
		lineageTag: 6b183d3e-5baf-4464-9ba3-9041cac9b6ed

	measure 'Populacao (por sede)' =
			CALCULATE (
				[Populacao],
				seg_cisp_municipio[CIMU_FL_SEDE] = "S"
			)
		formatString: #,0
		displayFolder: 40 Taxas
		lineageTag: 2fdb790c-ca20-406a-8c02-45fc75bb9449

	measure 'Municipios sem populacao' =
			CALCULATE (
				COUNTROWS ( seg_municipio ),
				ISBLANK ( seg_municipio[MUNI_QT_POPULACAO] )
			)
		formatString: #,0
		displayFolder: 40 Taxas
		lineageTag: 6e2f6805-f1c2-4acf-8075-917fbbde5a02

	measure 'Taxa de letalidade violenta (100 mil)' =
			DIVIDE (
				[Letalidade violenta (por sede)],
				[Populacao (por sede)]
			) * 100000
		formatString: #,0.0
		displayFolder: 40 Taxas
		lineageTag: bae73924-bf78-4b94-87a0-172355644df3

	measure 'Taxa de roubos (100 mil)' =
			DIVIDE (
				[Roubos (por sede)],
				[Populacao (por sede)]
			) * 100000
		formatString: #,0.0
		displayFolder: 40 Taxas
		lineageTag: 770b0e8e-c7f0-4219-b4c1-3efaea9a8f1f

	measure 'Taxa de furtos (100 mil)' =
			DIVIDE (
				[Furtos (por sede)],
				[Populacao (por sede)]
			) * 100000
		formatString: #,0.0
		displayFolder: 40 Taxas
		lineageTag: f1afde87-bef4-48d6-b9c8-2bdc463ee1b1

	measure 'Taxa de BOs (100 mil)' =
			DIVIDE (
				[Total de BOs (por sede)],
				[Populacao (por sede)]
			) * 100000
		formatString: #,0.0
		displayFolder: 40 Taxas
		lineageTag: 4ac3df8b-73a2-400c-9456-af080b709e3e

	measure 'Taxa de letalidade do estado (100 mil)' =
			CALCULATE (
				[Taxa de letalidade violenta (100 mil)],
				REMOVEFILTERS ( seg_municipio ),
				REMOVEFILTERS ( seg_regiao ),
				REMOVEFILTERS ( seg_cisp ),
				REMOVEFILTERS ( seg_aisp ),
				REMOVEFILTERS ( seg_risp )
			)
		formatString: #,0.0
		displayFolder: 40 Taxas
		lineageTag: cd0f91e6-0843-4e9f-bf59-eb332b672ff2

	measure 'Letalidade vs estado' =
			VAR Local = [Taxa de letalidade violenta (100 mil)]
			VAR Estado = [Taxa de letalidade do estado (100 mil)]
			RETURN
				DIVIDE ( Local - Estado, Estado )
		formatString: 0.0%
		displayFolder: 40 Taxas
		lineageTag: 63b6475e-6152-4b47-9d05-4b2e73e05877

