		lineageTag: be7798d5-1746-4006-9ef6-e3383c673a7e

	measure Estelionato =
			CALCULATE (
				[_Ocorrencias brutas],
				REMOVEFILTERS ( seg_tipo_ocorrencia ),
				REMOVEFILTERS ( seg_categoria_ocorrencia ),
