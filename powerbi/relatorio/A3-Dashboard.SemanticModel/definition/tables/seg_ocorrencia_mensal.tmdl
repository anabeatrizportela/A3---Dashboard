				REMOVEFILTERS ( seg_categoria_ocorrencia ),
				seg_tipo_ocorrencia[TIOC_CD_TIPO_OCORRENCIA] = "hom_por_interv_policial"
			)
		formatString: #,0
		displayFolder: 10 KPIs
		lineageTag: 4b3b9e51-b0dc-4bde-a913-9387b0144839

	measure Roubos =
