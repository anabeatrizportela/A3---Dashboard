// -------------------------------------------------------------------------
// Apoio ao grafico de linhas da pagina 1
// -------------------------------------------------------------------------

// Rotula so o mes de pico da serie, para a anotacao do grafico (out/2025,
// 431 mortes) acompanhar o filtro em vez de ser um texto fixo na tela.
Rotulo do pico de letalidade =
VAR MesesVisiveis = ALLSELECTED ( seg_periodo[PERI_DT_REFERENCIA] )
VAR MaiorValor =
	MAXX ( MesesVisiveis, [Letalidade violenta] )
RETURN
	IF ( [Letalidade violenta] = MaiorValor, [Letalidade violenta] )

// Media mensal do periodo filtrado, para a linha de referencia do grafico.
Letalidade violenta (media mensal) =
AVERAGEX (
	VALUES ( seg_periodo[PERI_DT_REFERENCIA] ),
	[Letalidade violenta]
)
